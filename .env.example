# Publer API
PUBLER_API_KEY=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/publer_mcp

# Redis
REDIS_URL=redis://localhost:6379

# API Server
PORT=3001
NODE_ENV=development

# Dashboard (Next.js public vars)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# AI (Anthropic)
ANTHROPIC_API_KEY=

# Auth / Security
JWT_SECRET=change_me_in_production_min_32_chars
SESSION_SECRET=change_me_in_production_min_32_chars

# Logging
LOG_LEVEL=info

# MCP Server
MCP_SERVER_NAME=publer-mcp
MCP_SERVER_VERSION=1.0.0
