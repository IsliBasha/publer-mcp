{
  "name": "@publer-mcp/api-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@publer-mcp/publer-client": "workspace:*",
    "@publer-mcp/shared-types": "workspace:*",
    "@prisma/client": "^5.14.0",
    "bullmq": "^5.12.0",
    "express": "^4.19.0",
    "express-rate-limit": "^7.3.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "pino": "^9.0.0",
    "pino-http": "^10.2.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.0",
    "ioredis": "^5.4.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.14.0",
    "tsx": "^4.10.0",
    "typescript": "^5.4.0"
  }
}
